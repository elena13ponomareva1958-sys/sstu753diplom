+    private fun openSuperCamera(ctrlBlock: USBMonitor.UsbControlBlock) {
+        stopSuperCamera()
+        if (!active) return
+        val device = currentDevice ?: ctrlBlock.device
+        superFirstFrameDelivered = false
+        superStartNs = System.nanoTime()
+        resetSuperDiagnostics()
+
+        try {
+            val target = findSuperVideoInterface(ctrlBlock, device)
+                ?: error("не найден IF1 alt1 com.useeplus.protocol")
+            val connection = ctrlBlock.connection
+            val claimed = runCatching {
+                ctrlBlock.claimInterface(target, true)
+                true
+            }.getOrElse { false }
+            if (!claimed) error("claim IF1 alt1 не выполнен")
+            postStatus("Mobile USB: permission OK; claim IF1 OK")
+
+            val altOk = runCatching { connection.setInterface(target) }.getOrDefault(false)
+            if (!altOk) error("не удалось выбрать IF1 alt1")
+            postStatus("Mobile USB: IF1 alt1 OK")
+
+            val videoIn = (0 until target.endpointCount)
+                .map(target::getEndpoint)
+                .firstOrNull {
+                    it.direction == UsbConstants.USB_DIR_IN &&
+                        it.type == UsbConstants.USB_ENDPOINT_XFER_BULK
+                } ?: error("на IF1 alt1 нет Bulk-IN endpoint")
+
+            val info = ByteArray(SUPER_INFO_LENGTH)
+            val infoResult = connection.controlTransfer(
+                SUPER_CLASS_DEVICE_IN,
+                0x00,
+                0x0005,
+                0x0000,
+                info,
+                info.size,
+                SUPER_CONTROL_TIMEOUT_MS,
+            )
+            val infoText = if (infoResult > 0) {
+                info.copyOf(infoResult).toString(Charsets.UTF_8).replace('\u0000', ' ').trim()
+            } else "нет ответа ($infoResult)"
+            Log.i(TAG, "SuperCamera control-IN info result=$infoResult text=$infoText")
+            postStatus("Mobile USB: control-IN=$infoResult")
+
+            val startPayload = ByteArray(64) { 0x30 }
+            val startResult = connection.controlTransfer(
+                SUPER_CLASS_DEVICE_OUT,
+                0x01,
+                0x0005,
+                0x0000,
+                startPayload,
+                startPayload.size,
+                SUPER_CONTROL_TIMEOUT_MS,
+            )
+            if (startResult != startPayload.size) {
+                error("START control-OUT: $startResult/${startPayload.size}")
+            }
+
+            superCtrlBlock = ctrlBlock
+            superConnection = connection
+            superInterface = target
+            superVideoIn = videoIn
+            val selected = UvcResolution(
+                SUPER_WIDTH,
+                SUPER_HEIGHT,
+                UVCCamera.FRAME_FORMAT_YUYV,
+                supportedFps = emptyList(),
+            )
+            currentResolution = selected
+            availableResolutions = listOf(selected)
+            postResolutions(listOf(selected), selected)
+            postStatus(
+                "Mobile USB transport запущен: IF${target.id} alt${target.alternateSetting}, " +
+                    "IN=0x%02X; ждём первый реальный кадр…".format(videoIn.address),
+            )
+            startSuperReader(selected)
+        } catch (error: Throwable) {
+            Log.e(TAG, "SuperCamera open failed", error)
+            stopSuperCamera()
+            postStatus("Прямой Mobile USB-режим не запустился: ${error.message ?: error.javaClass.simpleName}")
+        }
+    }
