+    private fun findSuperVideoInterface(
+        ctrlBlock: USBMonitor.UsbControlBlock,
+        device: UsbDevice,
+    ): UsbInterface? {
+        for (index in 0 until device.interfaceCount) {
+            val intf = device.getInterface(index)
+            if (intf.interfaceProtocol == 1 && intf.alternateSetting == 1 && intf.endpointCount > 0) {
+                return runCatching { ctrlBlock.getInterface(intf.id, intf.alternateSetting) }.getOrElse { intf }
+            }
+        }
+        return runCatching { ctrlBlock.getInterface(1, 1) }.getOrNull()
+    }
+
+    private fun startSuperReader(resolution: UvcResolution) {
+        val connection = superConnection ?: error("USB connection missing")
+        val endpoint = superVideoIn ?: error("Bulk-IN endpoint missing")
+        superStopRequested.set(false)
+        superReaderRunning = true
+        val thread = Thread({
+            val frame = ByteArray(SUPER_FRAME_BYTES)
+            val rgba = ByteArray(SUPER_WIDTH * SUPER_HEIGHT * 4)
+            val pixels = IntArray(SUPER_WIDTH * SUPER_HEIGHT)
+            var startRetries = 0
+            try {
+                while (!superStopRequested.get() && active) {
+                    val result = runCatching {
+                        connection.bulkTransfer(endpoint, frame, frame.size, SUPER_READ_TIMEOUT_MS)
+                    }.getOrElse { error ->
+                        Log.w(TAG, "SuperCamera bulk read error", error)
+                        -1
+                    }
+                    if (result <= 0) {
+                        if (!superFirstFrameDelivered && startRetries < SUPER_START_RETRIES) {
+                            startRetries++
+                            val retryPayload = ByteArray(64) { 0x30 }
+                            val retryResult = runCatching {
+                                connection.controlTransfer(
+                                    SUPER_CLASS_DEVICE_OUT,
+                                    0x01,
+                                    0x0005,
+                                    0x0000,
+                                    retryPayload,
+                                    retryPayload.size,
+                                    SUPER_CONTROL_TIMEOUT_MS,
+                                )
+                            }.getOrDefault(-1)
+                            Log.i(TAG, "SuperCamera start retry=$startRetries result=$retryResult")
+                            postStatus("Mobile USB: нет данных, повтор START $startRetries/$SUPER_START_RETRIES = $retryResult")
+                        }
+                        maybePostSuperDiagnostics(result)
+                        continue
+                    }
+                    superReadCount++
+                    superBytesRead += result
+
+                    if (result == SUPER_STATUS_BYTES && frame[0] == 0xDD.toByte() && frame[1] == 0xCC.toByte()) {
+                        superHeader511Count++
+                        maybePostSuperDiagnostics(result)
+                        continue
+                    }
+                    if (result != SUPER_FRAME_BYTES) {
+                        superShortReadCount++
+                        Log.d(TAG, "SuperCamera short/unexpected read=$result")
+                        maybePostSuperDiagnostics(result)
+                        continue
+                    }
+
+                    superFullFrameCount++
+                    if (!convertYuyvToRgbaAndArgb(frame, rgba, pixels)) {
+                        superConvertFailCount++
+                        maybePostSuperDiagnostics(result)
+                        continue
+                    }
+
+                    drawSuperPreview(pixels)
+                    onFrame(ByteBuffer.wrap(rgba), SUPER_WIDTH, SUPER_HEIGHT)
+
+                    if (!superFirstFrameDelivered) {
+                        superFirstFrameDelivered = true
+                        val firstMs = (System.nanoTime() - superStartNs) / 1_000_000L
+                        mainHandler.post {
+                            onConnected(resolution)
+                            onStatus(
+                                "Эндоскоп работает: Mobile USB 640 × 480 YUYV; " +
+                                    "первый кадр ${firstMs} мс, IN=0x%02X".format(endpoint.address),
+                            )
+                        }
+                    }
+                    maybePostSuperDiagnostics(result)
+                }
+            } finally {
+                superReaderRunning = false
+                Log.i(TAG, "SuperCamera reader stopped")
+            }
+        }, "technostrazh-supercamera-reader")
+        superReaderThread = thread
+        thread.start()
+    }
+
+    private fun convertYuyvToRgbaAndArgb(
+        yuyv: ByteArray,
+        rgba: ByteArray,
+        pixels: IntArray,
+    ): Boolean {
+        if (yuyv.size < SUPER_FRAME_BYTES || rgba.size < SUPER_WIDTH * SUPER_HEIGHT * 4) return false
+        var src = 0
+        var dst = 0
+        var pixel = 0
+        while (src + 3 < SUPER_FRAME_BYTES) {
+            val y0 = yuyv[src].toInt() and 0xFF
+            val u = (yuyv[src + 1].toInt() and 0xFF) - 128
+            val y1 = yuyv[src + 2].toInt() and 0xFF
+            val v = (yuyv[src + 3].toInt() and 0xFF) - 128
+            writeConvertedPixel(y0, u, v, rgba, dst, pixels, pixel)
+            writeConvertedPixel(y1, u, v, rgba, dst + 4, pixels, pixel + 1)
+            src += 4
+            dst += 8
+            pixel += 2
+        }
+        return pixel == SUPER_WIDTH * SUPER_HEIGHT
+    }
+
+    private fun writeConvertedPixel(
+        y: Int,
+        u: Int,
+        v: Int,
+        rgba: ByteArray,
+        offset: Int,
+        pixels: IntArray,
+        pixelIndex: Int,
+    ) {
+        val r = (y + ((359 * v) shr 8)).coerceIn(0, 255)
+        val g = (y - (((88 * u) + (183 * v)) shr 8)).coerceIn(0, 255)
+        val b = (y + ((454 * u) shr 8)).coerceIn(0, 255)
+        rgba[offset] = r.toByte()
+        rgba[offset + 1] = g.toByte()
+        rgba[offset + 2] = b.toByte()
+        rgba[offset + 3] = 0xFF.toByte()
+        pixels[pixelIndex] = (0xFF shl 24) or (r shl 16) or (g shl 8) or b
+    }
+
+    private fun drawSuperPreview(pixels: IntArray) {
+        val surface = superSurface ?: return
+        val bitmap = Bitmap.createBitmap(SUPER_WIDTH, SUPER_HEIGHT, Bitmap.Config.ARGB_8888)
+        try {
+            bitmap.setPixels(pixels, 0, SUPER_WIDTH, 0, 0, SUPER_WIDTH, SUPER_HEIGHT)
+            var canvas: Canvas? = null
+            try {
+                canvas = surface.lockCanvas(null)
+                val target = Rect(0, 0, canvas.width, canvas.height)
+                canvas.drawBitmap(bitmap, null, target, SUPER_PAINT)
+            } finally {
+                if (canvas != null) runCatching { surface.unlockCanvasAndPost(canvas) }
+            }
+        } catch (error: Throwable) {
+            Log.w(TAG, "SuperCamera preview draw failed", error)
+        } finally {
+            bitmap.recycle()
+        }
+    }
+
+    private fun maybePostSuperDiagnostics(lastRead: Int) {
+        val now = System.nanoTime()
+        if (now - superLastDiagNs < 1_000_000_000L) return
+        val elapsed = ((now - superLastDiagNs).coerceAtLeast(1L)).toDouble() / 1_000_000_000.0
+        val bytesDelta = superBytesRead - superLastDiagBytes
+        val bps = (bytesDelta / elapsed).toLong()
+        superLastDiagNs = now
+        superLastDiagBytes = superBytesRead
+        Log.i(
+            TAG,
+            "SuperCamera diag read=$lastRead reads=$superReadCount bytes=$superBytesRead bps=$bps " +
+                "frames=$superFullFrameCount hdr511=$superHeader511Count short=$superShortReadCount " +
+                "convertFail=$superConvertFailCount first=$superFirstFrameDelivered",
+        )
+        if (!superFirstFrameDelivered) {
+            postStatus(
+                "Mobile USB ждёт кадр: reads=$superReadCount, ${bps / 1024} KiB/s, " +
+                    "full=$superFullFrameCount, hdr511=$superHeader511Count, short=$superShortReadCount, last=$lastRead",
+            )
+        }
+    }
+
+    private fun resetSuperDiagnostics() {
+        superReadCount = 0L
+        superBytesRead = 0L
+        superHeader511Count = 0L
+        superFullFrameCount = 0L
+        superShortReadCount = 0L
+        superConvertFailCount = 0L
+        superLastDiagNs = System.nanoTime()
+        superLastDiagBytes = 0L
+    }
+
+    private fun stopSuperCamera() {
+        superStopRequested.set(true)
+        val thread = superReaderThread
+        if (thread != null && thread !== Thread.currentThread()) {
+            runCatching { thread.join(SUPER_STOP_JOIN_MS) }
+            if (thread.isAlive) {
+                Log.w(TAG, "SuperCamera reader did not stop within ${SUPER_STOP_JOIN_MS} ms")
+                runCatching { thread.interrupt() }
+                runCatching { thread.join(500L) }
+            }
+        }
+        superReaderThread = null
+        superReaderRunning = false
+        val intf = superInterface
+        val ctrl = superCtrlBlock
+        if (intf != null && ctrl != null) runCatching { ctrl.releaseInterface(intf) }
+        superInterface = null
+        superVideoIn = null
+        superConnection = null
+        superCtrlBlock = null
+        superFirstFrameDelivered = false
+        runCatching { superSurface?.release() }
+        superSurface = null
+        surfaceTexture?.let { texture ->
+            if (UsbEndoscopeSupport.isSuperCamera(currentDevice)) {
+                superSurface = runCatching { Surface(texture) }.getOrNull()
+            }
+        }
+    }
